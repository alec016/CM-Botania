{
  "schemaVersion": 1,
  "id": "custommachinerybotania",
  "version": "${mod_version}",
  "name": "CustomMachineryBotania",
  "description": "Custom Machinery addon for Botania",
  "authors": [
    "${author}"
  ],
  "contact": {
    "homepage": "${homepage}",
    "sources": "${github}"
  },
  "license": "${license}",
  "icon": "${icon}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "es.degrassi.custommachinerybotania.fabric.CustommachineryBotaniaFabric"
    ],
    "client": [
      "es.degrassi.custommachinerybotania.fabric.client.CustommachineryBotaniaFabricClient"
    ]
  },
  "mixins": [
    "custommachinerybotania.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.7",
    "minecraft": "~1.20.1",
    "java": ">=17",
    "fabric-api": "*",
    "architectury": ">=${architectury_version}",
    "botania": ">=${botania_version}",
    "custommachinery": ">=${custommachinery_version}"
  },
  "suggests": {
    "another-mod": "*"
  }
}
